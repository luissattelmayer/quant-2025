# Comparing coefficients
ess_model |>
unnest(tidied) |>
filter(term == "polintr") |>
ggplot(aes(
reorder(cntry, estimate),
y = exp(estimate),
color = cntry,
ymin = exp(conf.low),
ymax = exp(conf.high)
)) +
geom_errorbar() +
geom_point() +
scale_x_discrete("Country") +
ylab("Odds-Ratio of political interest") +
xlab("Country")
