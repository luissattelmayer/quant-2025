filter(cntry == "SE")
library(tidyverse)
ess <- read_csv("ESS_9.csv") |>
dplyr::select(cntry,
polintr,
trstprt,
vote,
clsprty,
gndr,
yrbrn,
eduyrs) |>
filter(cntry == "SE")
ess_final <- ess |>
filter(!vote %in% c(3, 7, 8, 9)) |>
mutate(polintr = replace(polintr, polintr %in% c(7:9), NA),
across(where(is.numeric), ~case_when(
. %in% c(66, 77, 88, 99, 7777, 8888, 9999) ~ NA_integer_,
TRUE ~ .)),
gndr = case_when(
gndr == 1 ~ 0,
gndr == 2 ~ 1),
vote = case_when(
vote == 2 ~ 0),
clsprty = case_when(
clsprty == 1 ~ 1,
clsprty == 0 ~ 0,
TRUE ~ NA_integer_
)
)
ess_final |> head()
summary(ess_final)
logit <- glm(clsprty ~ polintr + trstprt + vote + gndr +
yrbrn + eduyrs, data = ess_final, family = binomial(link = logit))
stargazer::stargazer(logit, type = "text")
