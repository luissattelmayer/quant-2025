model_vif <-
glm(
as.factor(vote_de) ~ imueclt  + stflife + trstplt + blgetmg +
gndr + yrbrn + eduyrs + hinctnta,
data = ess_clean,
family = binomial()
)
car::vif(model_vif)
needs('spotifyr',
'tidyverse',
'plotly',
'ggimage',
'httpuv',
'httr',
'usethis')
needs('spotifyr',
'tidyverse',
'plotly',
'ggimage',
'httpuv',
'httr',
'usethis')
access_token <- get_spotify_access_token()
top50 <- get_playlist_audio_features(playlist_uris = '37i9dQZEVXbIPWwFssbupI')
glimpse(top50)
#| warning: false
top50$rank <- seq.int(nrow(top50))
for (i in 1:50) {
top50$artist[i] <- top50[[28]][[i]]$name
top50$image[i] <- c(top50[[48]][[i]]$url[2], size=10, replace = TRUE)
}
ggplot(data = top50, aes(x = valence, y = danceability, text = (
paste("Track:",
track.name,
"<br>",
"Artist:",
artist)
))) +
geom_image(aes(image = image), asp = 1.5) +
theme_minimal() +
ylab("Danceability") +
xlab("Happiness")
library(ggridges)
taylor <- get_artist_audio_features('taylor swift')
taylor_filtered <- taylor |>
filter(
album_name %in% c(
"Speak Now (Taylor's Version)",
"evermore",
"Fearless (Taylor's Version)",
"folklore",
"Midnights (3am Edition)",
"Red (Taylor's Version)",
"Taylor Swift",
"reputation",
"1989 (Taylor's Version)",
"Lover"
)
) |>
arrange(album_release_year)
ggplot(taylor_filtered,
aes(x = valence, y = album_name, fill = after_stat(x))) +
geom_density_ridges_gradient() +
scale_fill_viridis_c(name = "Happiness", option = "C") +
labs(title = "Joyplot of Taylor Swift Albums (Based on Spotify's valence value)",
subtitle = " Built using the R-package spotifyr") +
theme_minimal() +
ylab("Album Name") +
xlab("Happiness score according to Spotify")
ggplot(taylor_filtered,
aes(x = danceability, y = album_name, fill = after_stat(x))) +
geom_density_ridges_gradient() +
scale_fill_viridis_c(name = "Danceability", option = "F") +
labs(title = "Danceplot of Taylor Swift Albums",
subtitle = " Built using the spotifyr package") +
theme_minimal() +
ylab("Album Name") +
xlab("Danceability score according to Spotify")
