library(tidyverse)
tac <- haven::read_dta("data/cmp_abouchadi.dta") |>
# as you can see the author provided a pre-cleaned, all set reproduction data-
# set which is seriously great!
select(
countryname,
cultposition,
sumright,
rileright,
limmig,
govparty,
pervote,
partyname,
date
) |>
group_by("partyname") |>
# lag() from the dplyr package will create a lagged variable for cultposition
mutate(lag_cultposition = dplyr::lag(cultposition))
library(plm)
fixed_effects <-
plm(
cultposition ~  lag_cultposition + sumright + limmig +
govparty + pervote,
data = tac,
index = c("partyname", "date"),
model = "within"
)
summary(fixed_effects)
fixed_effects
fixed_effects |> summary()
tac$partyname |> class()
random_effects <-
plm(
cultposition ~ lag_cultposition + sumright + limmig +
govparty + pervote + as.factor(partyname),
data = tac,
index = c("partyname", "date"),
model = "random"
)
fixed_effects <-
plm(
cultposition ~  lag_cultposition + sumright + limmig +
govparty + pervote + partyname |> as.factor(),
data = tac,
index = c("partyname", "date"),
model = "within"
)
summary(fixed_effects)
random_effects <-
plm(
cultposition ~ lag_cultposition + sumright + limmig +
govparty + pervote,
data = tac,
index = c("partyname", "date"),
model = "random"
)
random_effects <-
plm(
cultposition ~ lag_cultposition + sumright + limmig +
govparty + pervote,
data = tac,
index = c("partyname", "date"),
model = "random"
)
random_effects |> summary()
random_effects |> summary()
stargazer::stargazer(
fixed_effects,
random_effects,
title = "Model Results",
align = TRUE,
type = "text",
out = "class.txt",
dep.var.labels = "Position on Multiculturalism",
covariate.labels = c(
"Lag of Multic",
"Radical Right Support at t-1",
"Share of Immigration",
"Government Participation",
"Party Size"
)
)
phtest(fixed_effects, random_effects)
fixed_effects_fixest <-
feols(
cultposition ~ lag_cultposition + sumright + limmig +
govparty + pervote | partyname + date,
cluster = ~ partyname,
data = tac
)
library(fixest)
fixed_effects_fixest <-
feols(
cultposition ~ lag_cultposition + sumright + limmig +
govparty + pervote | partyname + date,
cluster = ~ partyname,
data = tac
)
feols(
cultposition ~ lag_cultposition + sumright + limmig +
govparty + pervote | partyname + date,
cluster = ~ partyname,
data = tac
)
feols(
cultposition ~ lag_cultposition + sumright + limmig +
govparty + pervote | partyname + date,
cluster = ~ partyname,
data = tac
)
feols(
cultposition ~ lag_cultposition + sumright + limmig +
govparty + pervote | partyname,
cluster = ~ partyname,
data = tac
)
feols(
cultposition ~ lag_cultposition + sumright + limmig +
govparty + pervote | partyname,
cluster = ~ partyname,
data = tac
)
fixed_effects |> summary()
